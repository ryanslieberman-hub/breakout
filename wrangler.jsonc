{
  // Deploys index.html as static assets to the "square-block-4d1b" Worker.
  //
  // HEADS UP: wrangler resolves JSON/JSONC config ahead of wrangler.toml, so a
  // bare `wrangler deploy` run from worker-payments/ or worker-pricing-engine/
  // picks THIS file up and deploys the static site instead of that Worker. Both
  // of those package.json scripts therefore pass `-c wrangler.toml` explicitly -
  // keep it that way, and deploy them via `npm run deploy`, never a bare
  // `npx wrangler deploy`.
  // Committing this avoids Wrangler's zero-config "set up this project"
  // wizard running on every Cloudflare build - that wizard was installing
  // wrangler's own `workerd` runtime (122 MiB) straight into this repo's
  // node_modules, which then got swept up and uploaded as a "site asset"
  // (since assets.directory is ".") and rejected for exceeding Cloudflare's
  // 25 MiB per-file limit. See .assetsignore for the other half of the fix.
  "name": "square-block-4d1b",
  "compatibility_date": "2026-07-28",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "."
  },
  // Adding "routes" makes Wrangler default workers_dev to false - explicitly
  // keep the old square-block-4d1b.ryanslieberman.workers.dev URL alive
  // alongside the new custom domain below. worker-payments' Stripe redirect
  // URLs and handoff.md both still point at it.
  "workers_dev": true,
  // Custom domain, registered via Cloudflare Registrar (2026-09-15) so it's
  // already a zone on this account - no nameserver migration needed.
  // custom_domain:true provisions the SSL cert and route automatically on
  // deploy. The bare workers.dev URL keeps working alongside this.
  "routes": [
    { "pattern": "breakoutmarket.com", "custom_domain": true },
    { "pattern": "www.breakoutmarket.com", "custom_domain": true }
  ]
}
