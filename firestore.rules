rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Shared config docs (price cache, etc.). Fully open, matching the most
    // permissive assumption about prior behavior (this repo never had a
    // committed rules file, and price-sync writes may happen from signed-out
    // sessions too) - not part of the money-safety scope this ruleset exists
    // for. NOTE: config/app currently stores a third-party API key here,
    // readable/writable by anyone. That's a separate pre-existing issue,
    // flagged but not fixed by this ruleset - see project notes.
    match /config/{doc} {
      allow read, write: if true;
    }

    // Trade log - append-only, owner-authored. Tamper-resistant (create-only,
    // no update/delete) which is exactly why settlement replays THIS
    // collection rather than trusting any client-writable portfolio snapshot.
    // Each doc carries a portfolioId (null = regular practice portfolio, else
    // a challengeId) so settlement can filter to a specific challenge's trades
    // precisely, instead of an ambiguous time window that breaks once a user
    // is in two overlapping challenges. A client mislabeling its own
    // portfolioId only misfiles the trade into the wrong replay bucket - it
    // can't forge value, so no rule change is needed for this field.
    //
    // price/shares/rank/type DO need shape checks here: settlement replays
    // `price` directly into cost/credit math (see worker-payments'
    // tradeReplay.js), so an unconstrained field here was a payout-integrity
    // hole, not a cosmetic one. These are cheap local checks only - no get()
    // calls, no attempt to validate `price` against a trusted market price
    // (that requires cross-doc lookups and stays server-side, in
    // tradeReplay.js's price-band check at settlement time, which is the
    // actual authority on price legitimacy).
    match /trades/{tradeId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid
        && request.resource.data.type in ['buy', 'sell']
        && request.resource.data.shares is number && request.resource.data.shares > 0
        && request.resource.data.price is number && request.resource.data.price > 0
        && request.resource.data.rank is number && request.resource.data.rank > 0;
      allow update, delete: if false;
    }

    // User profiles / free practice leaderboard. Self-reported
    // portfolioValue/returnPct here is fine for the free leaderboard (no real
    // money rides on it). Real-money challenge settlement NEVER reads this
    // doc - see challengeSnapshots below.
    //
    // A fixed set of fields is carved out as server-only (written exclusively
    // by worker-payments via its service account, which bypasses these rules
    // entirely) - the client may create/update its own doc but may never set
    // these directly:
    //   - stripeConnectId: settlement's payout code trusts this as the Stripe
    //     Connect destination for real money transfers. Letting a client set
    //     it themselves would let them redirect payouts to an arbitrary
    //     Connect account.
    //   - identityVerified / identityVerifiedAt / identityVerifiedAdult /
    //     stripeIdentitySessionId: real ID-verification results (Stripe
    //     Identity) - a client claiming these itself defeats the entire point
    //     of verifying identity server-side.
    //   - geoState / geoCountry / geoCheckedAt: real network-geolocation used
    //     to gate paid-challenge entry by jurisdiction - same reasoning as
    //     identity above.
    match /users/{uid} {
      allow read: if true;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'stripeConnectId', 'identityVerified', 'identityVerifiedAt', 'identityVerifiedAdult',
          'stripeIdentitySessionId', 'geoState', 'geoCountry', 'geoCheckedAt'
        ]);
      allow delete: if false;
    }

    match /portfolios/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      // One doc per challenge the user has joined, same trust level as the
      // parent doc above (client-writable convenience cache for fast
      // display/reload, e.g. "your challenge portfolio is worth $X right
      // now"). Just like the parent, this is NEVER the source of truth for
      // real-money settlement - that independently replays the tamper-
      // resistant /trades log (now tagged with portfolioId) against trusted
      // prices. A client could set cash here to anything; it can't forge a
      // payout because settlement never reads this doc.
      match /challenges/{challengeId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Comments (player comments + challenge chat, same collection) -
    // owner-authored, owner-deletable, likes are the only field anyone
    // else can bump. Player comments have no challengeId; challenge chat
    // messages do, and are further restricted to that challenge's own
    // participants - membership rides on the challenge doc's participants
    // map, the same source settlement trusts, not anything the client
    // asserts about itself.
    match /comments/{commentId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid
        && (
          !('challengeId' in request.resource.data) || request.resource.data.challengeId == null ||
          request.auth.uid in get(/databases/$(database)/documents/challenges/$(request.resource.data.challengeId)).data.participants
        );
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes']);
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // Global chat (main-nav Chat tab) - owner-authored, owner-deletable, separate
    // collection from `comments` (player/challenge threads) since this has much
    // higher volume and uses a plain orderBy query rather than client-side filtering.
    // `trade` is an optional embedded card (rank/type/shares/price/playerName) for
    // "share a trade" posts - display-only, never read by settlement or pricing.
    match /globalChat/{msgId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid
        && request.resource.data.kind in ['text', 'trade']
        && request.resource.data.text is string && request.resource.data.text.size() <= 280;
      allow update: if false;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // Username reservations - one doc per lowercase username, doc ID IS the
    // username, so "claim" is just create-if-doesn't-exist. `allow update: if false`
    // means a client trying to setDoc() an ALREADY-CLAIMED username hits the update
    // rule instead of create (Firestore's own create/update split is based on
    // whether the doc exists) and gets rejected - the standard Firestore pattern for
    // enforcing uniqueness without a Cloud Function. users/{uid}.usernameLower is
    // the denormalized copy search queries against; nothing here cross-checks that
    // it actually matches a doc the caller owns here - that's a display-only
    // convenience, not a security boundary, so it isn't worth the added rule
    // complexity (same reasoning as displayName/avatarColor elsewhere).
    match /usernames/{uname} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && uname == uname.lower()
        && uname.size() >= 3 && uname.size() <= 20
        && uname.matches('^[a-z0-9_]+$');
      allow update: if false;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // Friendships (mutual, request/accept). One doc per pair, id is the two uids
    // sorted and joined so a client never creates a duplicate/reverse-direction doc.
    // There is no "declined" state on purpose - declining a request, cancelling a
    // sent one, and unfriending are all just a delete, which sidesteps the awkward
    // case of a stale terminal doc blocking a later re-request from either side.
    match /friendships/{friendshipId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.requestedBy == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.users is list
        && request.resource.data.users.size() == 2
        && request.auth.uid in request.resource.data.users
        && request.resource.data.users[0] != request.resource.data.users[1];
      // Accept: only the non-requester may flip a pending request to accepted, and
      // only the status field may change.
      allow update: if request.auth != null
        && request.auth.uid in resource.data.users
        && resource.data.status == 'pending'
        && request.auth.uid != resource.data.requestedBy
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status == 'accepted';
      allow delete: if request.auth != null && request.auth.uid in resource.data.users;
    }

    // Challenges: admins (Firebase custom "admin" claim) may create a
    // challenge and edit its non-participant fields directly (name, dates,
    // description, entryFee).
    match /challenges/{challengeId} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.token.admin == true;

      // Admins may edit any field except participants - that's handled below
      // (free challenges) or exclusively by worker-payments (paid challenges).
      allow update: if request.auth != null && request.auth.token.admin == true
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['participants']);

      // Any signed-in user may join a FREE challenge (entryFee 0 or unset) by
      // writing only their own participants.{uid} entry - same trust model as
      // the free/casual leaderboard (no money at stake). A challenge with a
      // real entryFee can only gain participants via worker-payments, after
      // Stripe confirms payment - there is no client write path for that case.
      allow update: if request.auth != null
        && (!('entryFee' in resource.data) || resource.data.entryFee == 0)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participants'])
        && request.resource.data.participants.diff(resource.data.get('participants', {})).affectedKeys().hasOnly([request.auth.uid]);

      allow delete: if false;
    }

    // Push notification device tokens - keyed by the token itself, not uid.
    // Only read by trusted backend contexts (which bypass these rules), never
    // by clients.
    match /pushTokens/{token} {
      allow read: if false;
      allow create, update: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow delete: if false;
    }

    // Authoritative, server-computed player prices (currently NBA only - see
    // worker-pricing-engine). Written exclusively by that Worker's service
    // account, independently recomputed from real ESPN/balldontlie data -
    // never derived from anything a client can write. This is what
    // settlement values holdings against; it is NOT the same as the
    // client-writable config/prices cache used for casual display.
    match /priceEngine/{doc} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Default deny - anything not explicitly allowed above is rejected.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
